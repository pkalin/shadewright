{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shadewright chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executor",
    "analyzer"
  ],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "minProperties": 1
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "required": [
        "limits"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientId": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^--[a-zA-Z0-9][a-zA-Z0-9.-]*(=.*)?$"
          },
          "maxItems": 32
        },
        "podLabels": {
          "$ref": "#/definitions/labelMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotationMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/labelMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/affinity"
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/topologySpreadConstraints"
        },
        "priorityClassName": {
          "$ref": "#/definitions/priorityClassName"
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/pullSecrets"
        }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^--[a-zA-Z0-9][a-zA-Z0-9.-]*(=.*)?$"
          },
          "maxItems": 32
        },
        "podLabels": {
          "$ref": "#/definitions/labelMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotationMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/labelMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/affinity"
        },
        "watchNamespaces": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        },
        "maxIncidents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "topologySpreadConstraints": {
          "$ref": "#/definitions/topologySpreadConstraints"
        },
        "priorityClassName": {
          "$ref": "#/definitions/priorityClassName"
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/pullSecrets"
        }
      }
    },
    "labelMap": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 317,
        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 63
      }
    },
    "annotationMap": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string"
      }
    },
    "pullSecrets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "tolerations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 317
          },
          "operator": {
            "enum": [
              "Exists",
              "Equal"
            ]
          },
          "value": {
            "type": "string",
            "maxLength": 63
          },
          "effect": {
            "enum": [
              "",
              "NoSchedule",
              "PreferNoSchedule",
              "NoExecute"
            ]
          },
          "tolerationSeconds": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {
          "type": "object"
        },
        "podAffinity": {
          "type": "object"
        },
        "podAntiAffinity": {
          "type": "object"
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ],
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 317
          },
          "whenUnsatisfiable": {
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          },
          "labelSelector": {
            "type": "object"
          },
          "matchLabelKeys": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string"
            }
          },
          "minDomains": {
            "type": "integer",
            "minimum": 1
          },
          "nodeAffinityPolicy": {
            "enum": [
              "Honor",
              "Ignore"
            ]
          },
          "nodeTaintsPolicy": {
            "enum": [
              "Honor",
              "Ignore"
            ]
          }
        }
      }
    },
    "priorityClassName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "clusterId": {
      "type": "string",
      "pattern": "^([A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?)?$",
      "description": "Empty (the UID of kube-system) or 1 to 63 letters, digits, '.', '_' or '-', starting and ending with a letter or digit."
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/pullSecrets"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowTag": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secure": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h))*$",
              "maxLength": 32
            },
            "labels": {
              "$ref": "#/definitions/labelMap"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "crd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "helpers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "executor": {
      "$ref": "#/definitions/executor"
    },
    "analyzer": {
      "$ref": "#/definitions/analyzer"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/pullSecrets"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "spec": {
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "create": {
            "const": true
          }
        },
        "required": [
          "create"
        ]
      },
      "then": {
        "required": [
          "spec"
        ],
        "properties": {
          "spec": {
            "minProperties": 1
          }
        }
      }
    }
  }
}
