{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shadewright chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusterId", "executor", "analyzer"],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientId": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "component": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "identity": { "$ref": "#/definitions/identity" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraArgs": { "type": "array", "items": { "type": "string", "pattern": "^--[a-zA-Z0-9][a-zA-Z0-9.-]*(=.*)?$" } },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    }
  },
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "clusterId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$",
      "description": "1 to 63 letters, digits, '.', '_' or '-', starting and ending with a letter or digit."
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "crd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "helpers": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "executor": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        { "type": "object" }
      ]
    },
    "analyzer": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "required": ["watchNamespaces"],
          "properties": {
            "watchNamespaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" }
            },
            "maxIncidents": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "spec": { "type": "object" }
      },
      "if": { "properties": { "create": { "const": true } }, "required": ["create"] },
      "then": { "required": ["spec"], "properties": { "spec": { "minProperties": 1 } } }
    }
  }
}
